# ── Force HTTPS ───────────────────────────────────────────────────────────────
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteCond %{HTTPS} off
  RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [R=301,L]
</IfModule>

# ── Crawling ──────────────────────────────────────────────────────────────────
# Extends the noindex/nofollow meta tags already on the pages to cover all
# resources (fonts, ZIPs, PDFs, etc.) at the HTTP header level.
<IfModule mod_headers.c>
  Header always set X-Robots-Tag "noindex, nofollow, noarchive, nosnippet"
</IfModule>

# Block common crawlers and archivers outright.
# Note: keep Googlebot allowed so it can read the noindex meta tag — blocking it
# can cause the page to be indexed anyway because Google can't see the tag.
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteCond %{HTTP_USER_AGENT} (ia_archiver|Wayback|archive\.org|CCBot|DataForSeoBot|AhrefsBot|SemrushBot|MJ12bot|DotBot) [NC]
  RewriteRule ^ - [F,L]
</IfModule>

# ── Directory listing ──────────────────────────────────────────────────────────
Options -Indexes

# ── Protect sensitive files ────────────────────────────────────────────────────
<FilesMatch "\.(htaccess|htpasswd|env|log|sh|sql|bak|md)$">
  Require all denied
</FilesMatch>

# ── Security headers ───────────────────────────────────────────────────────────
<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Referrer-Policy "no-referrer"
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=()"
</IfModule>
